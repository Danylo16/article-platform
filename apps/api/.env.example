DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/articles?schema=public"
WEB_ORIGIN="http://localhost:5173"

# Local development (default): files are stored in apps/api/uploads.
MEDIA_STORAGE_DRIVER="local"

# Production with Cloudflare R2 or another S3-compatible provider:
# MEDIA_STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="article-platform-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Use a custom public domain in production, for example https://media.example.com.
# S3_PUBLIC_URL="https://media.example.com"

# Set these only while running `yarn workspace api admin:create`.
ADMIN_BOOTSTRAP_EMAIL="editor@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-at-least-15-characters"

# Set these only while running `yarn workspace api admin:reset-password`.
ADMIN_EMAIL="editor@example.com"
ADMIN_NEW_PASSWORD="replace-with-at-least-15-characters"

# Free one-shot address lookup through OpenStreetMap Nominatim.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="DORIDA-Article-Platform/1.0"
# Recommended when using the public Nominatim service:
NOMINATIM_CONTACT_EMAIL=""
