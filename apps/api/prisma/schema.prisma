generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Author {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  avatarUrl String?

  articles  Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          String        @id @default(uuid())

  title       String
  slug        String        @unique
  subtitle    String?
  excerpt     String?
  content     String

  coverImage  String?
  readingTime Int?

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  authorId    String
  author      Author        @relation(fields: [authorId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
}